# Generate a stable 32-byte value for non-development deployments.
MANAGENT_MCP_SECRET_KEY=0123456789abcdef0123456789abcdef

# Optional: when set, control-plane requests may use this bearer token.
MANAGENT_ADMIN_TOKEN=

MANAGENT_DATABASE_URL=postgres://postgres:postgres@postgres:5432/managent?sslmode=disable
MANAGENT_PORT=8080
