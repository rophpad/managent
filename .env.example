# Managent first-time deployment settings for docker compose.
# Leave MANAGENT_CONFIG as-is unless you provide your own config file.

MANAGENT_CONFIG=/app/config/managent.docker.json

# Gateway runtime
MANAGENT_PORT=8080
MANAGENT_DATABASE_URL=postgres://postgres:postgres@postgres:5432/managent?sslmode=disable

# Optional admin bearer token for dashboard/admin API access.
# Leave empty to rely only on user signup/login sessions.
MANAGENT_ADMIN_TOKEN=

# Required if you want to store encrypted MCP mcp secrets.
# Must be exactly 32 raw characters, or base64 that decodes to 32 bytes.
MANAGENT_MCP_SECRET_KEY=replace-with-32-byte-secret-key
